APP_APP_NAME=bangunin
APP_APP_ENV=development
APP_APP_PORT=8080

APP_DB_DSN=postgres://bangunin:bangunin@localhost:5432/bangunin?sslmode=disable
APP_DB_MAX_CONNS=10
APP_DB_MIN_CONNS=2
APP_DB_MAX_CONN_LIFE=1h

APP_REDIS_ADDR=localhost:6379
APP_REDIS_PASSWORD=
APP_REDIS_DB=0

APP_JWT_SECRET=change-me
APP_JWT_ACCESS_TTL=15m
APP_JWT_REFRESH_TTL=168h

APP_XENDIT_SECRET_KEY=
APP_XENDIT_CALLBACK_TOKEN=

APP_RAJAONGKIR_API_KEY=
APP_RAJAONGKIR_MOCK=true

APP_R2_ACCESS_KEY=minioadmin
APP_R2_SECRET_KEY=minioadmin
APP_R2_BUCKET=bangunin-dev
APP_R2_ENDPOINT=localhost:9000
APP_R2_USE_SSL=false

SEED_ADMIN_EMAIL=admin@bangunin.local
SEED_ADMIN_PASSWORD=change-me
